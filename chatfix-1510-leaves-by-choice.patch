+    // minimum" would read as a contradiction when the leaf is 199.5.
+    const shown = Number.isInteger(leaf) ? String(leaf) : leaf.toFixed(1);
+    return `Two doors would be ${shown} mm each, under the ${min} mm minimum leaf.`;
+  }
+  return '';
+}
