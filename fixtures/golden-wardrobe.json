    "drawer_panels": "2 doors -> DP left+right (numDrPanels=2); 1 door -> DP on hinge side only (numDrPanels=1). drawerReduction = numDrPanels * (dpInset + G)",
    "drawer_box": "boxWidth(szufSzer) = internalW - 10 - drawerReduction; frontW = boxWidth + 4; boxFrontLen = width - 4G - 10 - drawerReduction; boxFrontH = drawerSideH - 15 - G - 1; bottom = (boxFrontLen+13) x szufDl",
    "drawer_zone": "totalH = n*200 + (n-1)*3; partition (wieniec) bottom at G + totalH + 5; validation: totalH <= H - 2G - 200 else drawers cancelled",
    "drawer_fronts": "front height = 200, EXCEPT first (bottom) = 197 (drFirstAdj 3); width = frontW",
    "runners": "row Y relative to DP bottom = 38 + i*(200+3); relative to BUL/BUR bottom = G + 38 + i*203; holes 3mm at x {37, 69, 293} from front (mirrored on opposite face), layer RUNNERS_3MM",
