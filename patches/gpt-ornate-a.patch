+  window.__ornatePreview.variants.push({style,vertices:geometry.attributes.position.count,status:panel.meta.frontDecoration.status,referenceOnly:panel.meta.frontDecoration.referenceOnly});
+ }
+ window.__ornatePreview.ready=true;
+}catch(error){window.__ornatePreview.errors.push(String(error.stack||error));document.body.insertAdjacentHTML('beforeend',`<pre class="error">${String(error.stack||error)}</pre>`);throw error;}
