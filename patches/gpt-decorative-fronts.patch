+    points.push([x + radius * Math.cos(a), y0 + radius * Math.sin(a)]);
+  }
+  for (let i = 0; i <= steps; i += 1) {
+    const a = Math.PI * i / steps;
+    points.push([x + radius * Math.cos(a), y1 + radius * Math.sin(a)]);
+  }
