+    assert.ok(names.some((n) => /PROPOSED-operations\.json$/.test(n)));
+    assert.ok(!names.some((n) => /BACK\.dxf$/.test(n)));
+    assert.ok(output.held.some((h) => h.panelId === panel.id));
+    assert.ok(output.readinessBanner);
