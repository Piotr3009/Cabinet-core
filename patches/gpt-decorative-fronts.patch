+
+function insetPolygon(outline, inset) {
+  let result = outline.map((p) => [...p]);
+  for (let i = 0; i < outline.length && result.length; i += 1) {
+    result = clipHalfPlane(result, outline[i], outline[(i + 1) % outline.length], inset);
+  }
