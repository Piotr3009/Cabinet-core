+  for (let y = y0; y < y1; y += 1) {
+    for (let x = x0; x < x1; x += 1) {
+      const i = y * stride + x * channels;
+      sum += (out[i] + out[i + 1] + out[i + 2]) / 3; n += 1;
+    }
+  }
+  return n ? sum / n : 0;
