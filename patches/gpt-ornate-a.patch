+    for (const point of points) lines.push(`      vertex ${point.map(fmt).join(' ')}`);
+    lines.push('    endloop', '  endfacet');
+  }
+  lines.push(`endsolid ${fileSafeName(name, 'ORNATE_PROPOSED_REFERENCE')}`, '');
